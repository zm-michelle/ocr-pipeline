# Copy to remote/hpc.env and fill in. No secrets here -- SSH keys do the auth.
HPC_HOST=login.hpc.example.edu     # the login node you `ssh` to
HPC_USER=yourusername
HPC_DIR=ocr_folder                # project dir on the cluster: relative = under $HOME; absolute = as-is (e.g. /N/slate/you/Luddy_hacks). Created on first push.
HPC_PARTITION=gpu                  # `sinfo` shows partitions; pick the GPU one
HPC_ACCOUNT=                       # leave blank if your cluster does not bill by account
HPC_TIME=08:00:00
HPC_GRES=gpu:1                     # e.g. gpu:a100:1 to pin a GPU type
HPC_PYTHON=python3                 # python on the LOGIN node used to build .venv (after `module load` if needed)
HPC_MODULES=                       # space-separated, from `module avail python`; e.g. python/gpu/3.12.5 on IU Quartz. Loaded for setup and inside the job.

# Where the job reads/writes datasets. Put this on the cluster's big scratch/project
# filesystem (IU: /N/slate/<user>/...), not in home: home quotas are small and GPFS
# home is slow for the ~10 files per page a dataset creates.
DATA_DIR=
